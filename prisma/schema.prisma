generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  CUSTOMER
  ARCHIVED
}

enum ContactVerificationStatus {
  UNKNOWN
  UNVERIFIED
  VERIFIED
  INVALID
}

enum LeadStatus {
  NEW
  REVIEW
  QUALIFIED
  DISQUALIFIED
  CONTACTED
  ENGAGED
  OPPORTUNITY
  CONVERTED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  TASK
  STATUS_CHANGE
  RESEARCH
}

enum LeadSourceType {
  WEB_SEARCH
  WEBSITE
  DIRECTORY
  JOB_BOARD
  SOCIAL_PUBLIC
  PUBLIC_DATABASE
  SITEMAP
  CUSTOM
}

enum SourceCapability {
  DISCOVERY
  SCRAPING
  SEARCH
  DIRECTORY
  COMPANY_EXTRACTION
  CONTACT_EXTRACTION
  EMAIL_EXTRACTION
}

enum ScraperRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ScraperRunEventLevel {
  INFO
  WARNING
  ERROR
}

// Lead candidate lifecycle (TASK 008). Deliberately distinct from
// ScraperRunStatus: candidates are extracted, not "completed".
enum CandidateStatus {
  PENDING
  PROCESSING
  EXTRACTED
  SKIPPED
  FAILED
  DUPLICATE
  REVIEW
  READY
  CONVERTED
}

// TASK 010: conversion of a LeadCandidate into CRM entities (§9, §13).
enum ConversionStatus {
  NOT_CONVERTED
  READY
  CONVERTED
  SKIPPED
  FAILED
  NEEDS_REVIEW
}

enum ExtractionMethod {
  DETERMINISTIC
  AI
  HYBRID
}

model User {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  passwordHash        String
  name                String
  role                Role                      @default(MEMBER)
  organizationId      String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions            Session[]
  ownedLeads          Lead[]                    @relation("LeadOwner")
  ownedDeals          Deal[]                    @relation("DealOwner")
  createdActivities   Activity[]                @relation("ActivityCreator")
  createdLists        LeadList[]                @relation("LeadListCreator")
  createdICPs         ICPProfile[]              @relation("ICPCreator")
  createdSources      LeadSource[]              @relation("LeadSourceCreator")
  convertedCandidates LeadCandidateConversion[] @relation("CandidateConverter")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model Organization {
  id                       String                    @id @default(cuid())
  name                     String
  users                    User[]
  sessions                 Session[]
  companies                Company[]
  contacts                 Contact[]
  leads                    Lead[]
  leadLists                LeadList[]
  activities               Activity[]
  pipelineStages           PipelineStage[]
  deals                    Deal[]
  icpProfiles              ICPProfile[]
  leadSources              LeadSource[]
  scraperRuns              ScraperRun[]
  rawLeads                 RawLead[]
  rawPages                 RawPage[]
  extractionRuns           ExtractionRun[]
  leadCandidates           LeadCandidate[]
  candidateContacts        CandidateContact[]
  entityMatches            EntityMatch[]
  duplicateGroups          DuplicateGroup[]
  duplicateGroupMembers    DuplicateGroupMember[]
  duplicateAuditEvents     DuplicateAuditEvent[]
  leadCandidateConversions LeadCandidateConversion[]
  leadScores               LeadScore[]
  leadScoreJobs            LeadScoreJob[]
  scoringAuditEvents       ScoringAuditEvent[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model Session {
  id             String       @id @default(cuid())
  token          String       @unique
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Company {
  id                   String                    @id @default(cuid())
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  normalizedName       String
  domain               String?
  website              String?
  industry             String?
  employeeCount        Int?
  employeeRange        String?
  revenueRange         String?
  country              String?
  state                String?
  city                 String?
  description          String?
  phone                String?
  linkedinUrl          String?
  source               String?
  sourceCandidateId    String?
  status               CompanyStatus             @default(PROSPECT)
  contacts             Contact[]
  leads                Lead[]
  activities           Activity[]
  deals                Deal[]
  candidateConversions LeadCandidateConversion[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  lastVerifiedAt       DateTime?

  @@unique([organizationId, domain])
  @@index([organizationId, sourceCandidateId])
  @@index([organizationId, normalizedName])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
}

model Contact {
  id                   String                    @id @default(cuid())
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId            String?
  company              Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  firstName            String
  lastName             String?
  fullName             String
  jobTitle             String?
  department           String?
  email                String?
  phone                String?
  linkedinUrl          String?
  source               String?
  sourceCandidateId    String?
  confidence           Float?
  verificationStatus   ContactVerificationStatus @default(UNKNOWN)
  leads                Lead[]
  candidateConversions LeadCandidateConversion[]
  activities           Activity[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, sourceCandidateId])
  @@index([organizationId, fullName])
  @@index([organizationId, companyId])
}

model Lead {
  id                   String                    @id @default(cuid())
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId            String?
  company              Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId            String?
  contact              Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title                String?
  notes                String?
  status               LeadStatus                @default(NEW)
  score                Int?
  fitScore             Int?
  intentScore          Int?
  engagementScore      Int?
  priority             LeadPriority              @default(MEDIUM)
  ownerId              String?
  owner                User?                     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  candidateConversions LeadCandidateConversion[]
  source               String?
  sourceCandidateId    String?
  sourceCandidate      LeadCandidate?  @relation("CandidateConversionLead", fields: [sourceCandidateId], references: [id], onDelete: SetNull)
  lists                LeadListMembership[]
  activities           Activity[]
  deals                Deal[]
  scores               LeadScore[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  lastActivityAt       DateTime?

  @@index([organizationId, status])
  @@index([organizationId, score])
  @@index([organizationId, priority])
  @@index([organizationId, ownerId])
  @@index([organizationId, companyId])
  @@index([organizationId, contactId])
  @@index([organizationId, createdAt])
  @@index([organizationId, updatedAt])
  @@index([organizationId, source])
  @@index([organizationId, sourceCandidateId])
}

model LeadList {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdById    String?
  createdBy      User?                @relation("LeadListCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships    LeadListMembership[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LeadListMembership {
  id        String   @id @default(cuid())
  listId    String
  list      LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([listId, leadId])
  @@index([leadId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type           ActivityType
  title          String
  description    String?
  createdById    String?
  createdBy      User?        @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, leadId])
  @@index([organizationId, companyId])
  @@index([organizationId, contactId])
  @@index([organizationId, createdAt])
}

model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  position       Int
  color          String?
  isClosed       Boolean      @default(false)
  isWon          Boolean      @default(false)
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, position])
}

model ICPProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  criteria       Json
  isActive       Boolean      @default(false)
  createdById    String?
  createdBy      User?        @relation("ICPCreator", fields: [createdById], references: [id], onDelete: SetNull)
  scraperRuns    ScraperRun[]
  scores         LeadScore[]
  scoreJobs      LeadScoreJob[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
}

model Deal {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name              String
  value             Decimal       @default(0)
  currency          String        @default("USD")
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  expectedCloseDate DateTime?
  description       String?
  ownerId           String?
  owner             User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, stageId])
  @@index([organizationId, leadId])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt])
}

model LeadSource {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  type           LeadSourceType
  description    String?
  isActive       Boolean            @default(false)
  config         Json
  capabilities   SourceCapability[]
  createdById    String?
  createdBy      User?              @relation("LeadSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  runs           ScraperRun[]
  rawLeads       RawLead[]
  rawPages       RawPage[]
  leadCandidates LeadCandidate[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, type])
  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
}

model RawLead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceId       String
  source         LeadSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  runId          String
  run            ScraperRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalId     String?
  rawData        Json
  sourceUrl      String?
  discoveredAt   DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([organizationId, sourceId, externalId])
  @@index([organizationId, sourceId])
  @@index([organizationId, runId])
  @@index([organizationId, externalId])
  @@index([organizationId, createdAt])
}

model RawPage {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId          String
  run            ScraperRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId       String
  source         LeadSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  url            String
  statusCode     Int?
  errorCategory  String?
  title          String?
  contentType    String?
  html           String?        @db.Text
  textContent    String?        @db.Text
  metadata       Json?
  fetchedAt      DateTime       @default(now())
  createdAt      DateTime       @default(now())
  leadCandidate  LeadCandidate?

  @@index([organizationId, runId])
  @@index([organizationId, sourceId])
  @@index([organizationId, url])
  @@index([organizationId, statusCode])
  @@index([organizationId, createdAt])
}

model ScraperRun {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceId         String
  source           LeadSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  icpId            String?
  icp              ICPProfile?       @relation(fields: [icpId], references: [id], onDelete: SetNull)
  status           ScraperRunStatus  @default(QUEUED)
  startedAt        DateTime?
  finishedAt       DateTime?
  heartbeatAt      DateTime?
  recordsFound     Int               @default(0)
  recordsProcessed Int               @default(0)
  recordsCreated   Int               @default(0)
  recordsUpdated   Int               @default(0)
  recordsDuplicate Int               @default(0)
  recordsFailed    Int               @default(0)
  pagesDiscovered  Int               @default(0)
  pagesQueued      Int               @default(0)
  pagesProcessed   Int               @default(0)
  pagesSucceeded   Int               @default(0)
  pagesFailed      Int               @default(0)
  pagesSkipped     Int               @default(0)
  errorMessage     String?
  metadata         Json?
  events           ScraperRunEvent[]
  rawLeads         RawLead[]
  rawPages         RawPage[]
  extractionRun    ExtractionRun?
  leadCandidates   LeadCandidate[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, sourceId])
  @@index([organizationId, icpId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, startedAt])
  @@index([organizationId, status, heartbeatAt])
}

model ScraperRunEvent {
  id        String               @id @default(cuid())
  runId     String
  run       ScraperRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     ScraperRunEventLevel @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime             @default(now())

  @@index([runId, createdAt])
  @@index([runId, level])
}

// One extraction run per scraper run: observable progress + AI usage stats.
model ExtractionRun {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scraperRunId      String          @unique
  scraperRun        ScraperRun      @relation(fields: [scraperRunId], references: [id], onDelete: Cascade)
  status            CandidateStatus @default(PENDING)
  pagesProcessed    Int             @default(0)
  pagesSkipped      Int             @default(0)
  pagesFailed       Int             @default(0)
  candidatesCreated Int             @default(0)
  aiCalls           Int             @default(0)
  aiFailures        Int             @default(0)
  aiInputChars      Int             @default(0)
  aiOutputChars     Int             @default(0)
  startedAt         DateTime?
  finishedAt        DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, scraperRunId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// One candidate per crawled page; multiple people on a page become child
// CandidateContact rows, not separate candidates (spec §41).
model LeadCandidate {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId                String
  run                  ScraperRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId             String
  source               LeadSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  rawPageId            String            @unique
  rawPage              RawPage           @relation(fields: [rawPageId], references: [id], onDelete: Cascade)
  pageClassification   String?
  status               CandidateStatus   @default(PENDING)
  extractionMethod     ExtractionMethod?
  extractionConfidence Float?
  extractionVersion    String            @default("1")
  contentHash          String?
  aiUsed               Boolean           @default(false)

  companyName           String?
  normalizedCompanyName String?
  companyDomain         String?
  websiteUrl            String?
  description           String?
  industry              String?
  country               String?
  region                String?
  city                  String?
  logoUrl               String?

  contactFullName  String?
  contactFirstName String?
  contactLastName  String?
  contactJobTitle  String?
  email            String?
  phoneRaw         String?
  phone            String?
  normalizedPhone  String?
  linkedinUrl      String?

  socialLinks     Json?
  jobs            Json?
  fieldProvenance Json?
  fieldConfidence Json?
  rawData         Json?
  normalizedData  Json?

  dataQualityScore   Int?
  qualityFlags       Json?
  qualityExplanation Json?

  contacts             CandidateContact[]
  entityMatchesA       EntityMatch[]             @relation("matchA")
  entityMatchesB       EntityMatch[]             @relation("matchB")
  duplicateMemberships DuplicateGroupMember[]
  canonicalOfGroups    DuplicateGroup[]          @relation("canonicalOf")
  conversions          LeadCandidateConversion[]
  convertedLeads        Lead[]              @relation("CandidateConversionLead")
  scores               LeadScore[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([organizationId, rawPageId])
  @@index([organizationId, status])
  @@index([organizationId, runId])
  @@index([organizationId, sourceId])
  @@index([organizationId, companyDomain])
  @@index([organizationId, normalizedCompanyName])
  @@index([organizationId, email])
  @@index([organizationId, normalizedPhone])
  @@index([organizationId, linkedinUrl])
  @@index([organizationId, extractionMethod])
  @@index([organizationId, contentHash])
  @@index([organizationId, dataQualityScore])
  @@index([organizationId, createdAt])
}

model CandidateContact {
  id             String        @id @default(cuid())
  candidateId    String
  candidate      LeadCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName       String
  firstName      String?
  lastName       String?
  jobTitle       String?
  email          String?
  phone          String?
  linkedinUrl    String?
  confidence     Float?
  provenance     Json?
  createdAt      DateTime      @default(now())

  @@index([candidateId])
  @@index([organizationId, email])
  @@index([organizationId, fullName])
}

// ── TASK 009: duplicate resolution ───────────────────────────────────────

enum EntityType {
  COMPANY
  CONTACT
}

enum MatchConfidence {
  HIGH
  MEDIUM
  LOW
}

enum MatchStatus {
  AUTO_MATCH
  REVIEW
  NOT_MATCH
}

enum DuplicateGroupStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
  AUTO_MERGED
}

// Pairwise match between two candidates. candidateAId < candidateBId always
// (sorted at write time) so the pair identity is deterministic and unique.
model EntityMatch {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     EntityType
  candidateAId   String
  candidateA     LeadCandidate   @relation("matchA", fields: [candidateAId], references: [id], onDelete: Cascade)
  candidateBId   String
  candidateB     LeadCandidate   @relation("matchB", fields: [candidateBId], references: [id], onDelete: Cascade)
  score          Int
  confidence     MatchConfidence
  reasons        Json
  status         MatchStatus
  createdAt      DateTime        @default(now())

  @@unique([organizationId, candidateAId, candidateBId])
  @@index([organizationId, status])
  @@index([organizationId, entityType, status])
  @@index([organizationId, candidateAId])
  @@index([organizationId, candidateBId])
}

// A confirmed/reviewable duplicate group; members reference the original
// candidates (never deleted, provenance preserved).
model DuplicateGroup {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType           EntityType
  status               DuplicateGroupStatus   @default(PENDING_REVIEW)
  confidence           Int?
  canonicalCandidateId String?
  canonicalCandidate   LeadCandidate?         @relation("canonicalOf", fields: [canonicalCandidateId], references: [id], onDelete: SetNull)
  mergedData           Json?
  conflicts            Json?
  members              DuplicateGroupMember[]
  auditEvents          DuplicateAuditEvent[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, entityType, status])
  @@index([organizationId, canonicalCandidateId])
}

model DuplicateGroupMember {
  id               String         @id @default(cuid())
  duplicateGroupId String
  duplicateGroup   DuplicateGroup @relation(fields: [duplicateGroupId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        LeadCandidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  matchScore       Int?
  matchReasons     Json?
  addedAt          DateTime       @default(now())

  @@unique([duplicateGroupId, candidateId])
  @@index([candidateId])
  @@index([organizationId])
}

enum DuplicateAuditAction {
  USER_CONFIRMED_DUPLICATE
  USER_REJECTED_DUPLICATE
  CANONICAL_SELECTED
  AUTO_MERGED
}

model DuplicateAuditEvent {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupId        String
  group          DuplicateGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  action         DuplicateAuditAction
  actorUserId    String?
  actorName      String?
  details        Json?
  createdAt      DateTime             @default(now())

  @@index([organizationId, groupId, createdAt])
}

// TASK 010: persistent conversion record — explicit audit trail from
// LeadCandidate to CRM Company/Contact/Lead (§10, §26-§27, §87).
model LeadCandidateConversion {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId    String           @unique
  candidate      LeadCandidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status         ConversionStatus @default(NOT_CONVERTED)
  convertedById  String?
  convertedBy    User?            @relation("CandidateConverter", fields: [convertedById], references: [id], onDelete: SetNull)
  convertedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, companyId])
  @@index([organizationId, contactId])
  @@index([organizationId, leadId])
  @@index([organizationId, convertedAt])
}

// ── TASK 012: lead scoring + ICP qualification ────────────────────────────

enum Qualification {
  HOT
  GOOD
  MAYBE
  LOW
  UNQUALIFIED
}

enum ScoreSource {
  CANDIDATE
  CRM
}

enum ScoreStatus {
  CURRENT
  STALE
}

enum LeadScoreJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ScoringAuditAction {
  ICP_CREATED
  ICP_UPDATED
  ICP_ACTIVATED
  ICP_DEACTIVATED
  LEAD_SCORED
  LEAD_RESCORED
  BULK_SCORING_STARTED
  BULK_SCORING_COMPLETED
}

// Append-only scoring history. One row per scoring event; the newest row
// with scoreStatus CURRENT is the authoritative score (§16-§19, §61-§65).
model LeadScore {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  candidateId    String?
  candidate      LeadCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  icpProfileId   String?
  icpProfile     ICPProfile?   @relation(fields: [icpProfileId], references: [id], onDelete: SetNull)
  source         ScoreSource
  modelVersion   String
  icpScore       Int
  overallScore   Int
  qualification  Qualification
  scoreStatus    ScoreStatus   @default(CURRENT)
  scoreBreakdown Json
  reasons        Json
  scoredAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, leadId, scoreStatus])
  @@index([organizationId, leadId, scoredAt])
  @@index([organizationId, candidateId, scoreStatus])
  @@index([organizationId, candidateId, scoredAt])
  @@index([organizationId, icpProfileId])
  @@index([organizationId, qualification, scoreStatus])
  @@index([organizationId, overallScore, scoreStatus])
  @@index([organizationId, scoreStatus])
  @@index([organizationId, scoredAt])
}

// Bulk scoring job with observable progress (§59-§60).
model LeadScoreJob {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  icpProfileId   String?
  icpProfile     ICPProfile?        @relation(fields: [icpProfileId], references: [id], onDelete: SetNull)
  candidateIds   Json?
  status         LeadScoreJobStatus @default(PENDING)
  total          Int                @default(0)
  processed      Int                @default(0)
  scored         Int                @default(0)
  failed         Int                @default(0)
  hot            Int                @default(0)
  good           Int                @default(0)
  maybe          Int                @default(0)
  low            Int                @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// TASK 012 audit trail (§58): ICP lifecycle + scoring events.
model ScoringAuditEvent {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action         ScoringAuditAction
  actorUserId    String?
  actorName      String?
  details        Json?
  createdAt      DateTime          @default(now())

  @@index([organizationId, action, createdAt])
  @@index([organizationId, createdAt])
}
