generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  CUSTOMER
  ARCHIVED
}

enum ContactVerificationStatus {
  UNKNOWN
  UNVERIFIED
  VERIFIED
  INVALID
}

enum LeadStatus {
  NEW
  REVIEW
  QUALIFIED
  DISQUALIFIED
  CONTACTED
  ENGAGED
  OPPORTUNITY
  CONVERTED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  TASK
  STATUS_CHANGE
  RESEARCH
  SEQUENCE
}

enum LeadSourceType {
  WEB_SEARCH
  WEBSITE
  DIRECTORY
  JOB_BOARD
  SOCIAL_PUBLIC
  PUBLIC_DATABASE
  SITEMAP
  CUSTOM
}

enum SourceCapability {
  DISCOVERY
  SCRAPING
  SEARCH
  DIRECTORY
  COMPANY_EXTRACTION
  CONTACT_EXTRACTION
  EMAIL_EXTRACTION
}

enum ScraperRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ScraperRunEventLevel {
  INFO
  WARNING
  ERROR
}

// Lead candidate lifecycle (TASK 008). Deliberately distinct from
// ScraperRunStatus: candidates are extracted, not "completed".
enum CandidateStatus {
  PENDING
  PROCESSING
  EXTRACTED
  SKIPPED
  FAILED
  DUPLICATE
  REVIEW
  READY
  CONVERTED
}

// TASK 010: conversion of a LeadCandidate into CRM entities (§9, §13).
enum ConversionStatus {
  NOT_CONVERTED
  READY
  CONVERTED
  SKIPPED
  FAILED
  NEEDS_REVIEW
}

enum ExtractionMethod {
  DETERMINISTIC
  AI
  HYBRID
}

model User {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  passwordHash        String
  name                String
  role                Role                      @default(MEMBER)
  organizationId      String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions            Session[]
  ownedLeads          Lead[]                    @relation("LeadOwner")
  ownedDeals          Deal[]                    @relation("DealOwner")
  createdActivities   Activity[]                @relation("ActivityCreator")
  createdLists        LeadList[]                @relation("LeadListCreator")
  createdICPs         ICPProfile[]              @relation("ICPCreator")
  createdSources      LeadSource[]              @relation("LeadSourceCreator")
  convertedCandidates LeadCandidateConversion[] @relation("CandidateConverter")
  requestedEnrichments EnrichmentRequest[]       @relation("EnrichmentRequester")
  resolvedConflicts    EnrichmentConflict[]      @relation("ConflictResolver")
  emailEvents          EmailEvent[]              @relation("EmailEventActor")
  emailDiscoveryJobs   EmailDiscoveryJob[]       @relation("EmailDiscoveryRequester")
  emailVerificationBatches EmailVerificationBatch[] @relation("EmailVerificationRequester")
  resolvedEmailConflicts EmailConflict[]         @relation("EmailConflictResolver")
  emailTemplateCreated EmailTemplate[]           @relation("EmailTemplateCreator")
  communicationsCreated Communication[]          @relation("CommunicationCreator")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
}

model Organization {
  id                       String                    @id @default(cuid())
  name                     String
  users                    User[]
  sessions                 Session[]
  companies                Company[]
  contacts                 Contact[]
  leads                    Lead[]
  leadLists                LeadList[]
  activities               Activity[]
  pipelineStages           PipelineStage[]
  deals                    Deal[]
  icpProfiles              ICPProfile[]
  leadSources              LeadSource[]
  scraperRuns              ScraperRun[]
  rawLeads                 RawLead[]
  rawPages                 RawPage[]
  extractionRuns           ExtractionRun[]
  leadCandidates           LeadCandidate[]
  candidateContacts        CandidateContact[]
  entityMatches            EntityMatch[]
  duplicateGroups          DuplicateGroup[]
  duplicateGroupMembers    DuplicateGroupMember[]
  duplicateAuditEvents     DuplicateAuditEvent[]
  leadCandidateConversions LeadCandidateConversion[]
  leadScores               LeadScore[]
  leadScoreJobs            LeadScoreJob[]
  scoringAuditEvents       ScoringAuditEvent[]
  leadClassifications      LeadClassification[]
  enrichmentSettings       EnrichmentSettings?
  enrichmentRequests       EnrichmentRequest[]
  enrichmentResults        EnrichmentResult[]
  enrichmentConflicts      EnrichmentConflict[]
  enrichmentAuditEvents    EnrichmentAuditEvent[]
  emailSettings            EmailSettings?
  emailAddresses           EmailAddress[]
  emailEvents              EmailEvent[]
  emailConflicts           EmailConflict[]
  emailDiscoveryJobs       EmailDiscoveryJob[]
  emailVerificationJobs    EmailVerificationJob[]
  emailVerificationBatches EmailVerificationBatch[]
  leadReadinesses          LeadReadiness[]
  emailAccounts            EmailAccount[]
  emailTemplates           EmailTemplate[]
  communications           Communication[]
  outboxMessages           OutboxMessage[]
  sequences                Sequence[]
  sequenceEnrollments      SequenceEnrollment[]
  sequenceStepExecutions   SequenceStepExecution[]
  sequenceTasks            SequenceTask[]
  sequenceAuditEvents      SequenceAuditEvent[]
  emailWebhookEvents       EmailWebhookEvent[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model Session {
  id             String       @id @default(cuid())
  token          String       @unique
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Company {
  id                   String                    @id @default(cuid())
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  normalizedName       String
  domain               String?
  website              String?
  industry             String?
  employeeCount        Int?
  employeeRange        String?
  revenueRange         String?
  country              String?
  state                String?
  city                 String?
  description          String?
  phone                String?
  linkedinUrl          String?
  source               String?
  sourceCandidateId    String?
  status               CompanyStatus             @default(PROSPECT)
  contacts             Contact[]
  leads                Lead[]
  activities           Activity[]
  deals                Deal[]
  candidateConversions LeadCandidateConversion[]
  emailAddresses       EmailAddress[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  lastVerifiedAt       DateTime?

  @@unique([organizationId, domain])
  @@index([organizationId, sourceCandidateId])
  @@index([organizationId, normalizedName])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
}

model Contact {
  id                   String                    @id @default(cuid())
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId            String?
  company              Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  firstName            String
  lastName             String?
  fullName             String
  jobTitle             String?
  department           String?
  email                String?
  phone                String?
  linkedinUrl          String?
  source               String?
  sourceCandidateId    String?
  confidence           Float?
  verificationStatus   ContactVerificationStatus @default(UNKNOWN)
  doNotContact         Boolean                   @default(false)
  leads                Lead[]
  candidateConversions LeadCandidateConversion[]
  activities           Activity[]
  emailAddresses       EmailAddress[]
  communications       Communication[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, sourceCandidateId])
  @@index([organizationId, fullName])
  @@index([organizationId, companyId])
}

model Lead {
  id                   String                    @id @default(cuid())
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId            String?
  company              Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId            String?
  contact              Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title                String?
  notes                String?
  status               LeadStatus                @default(NEW)
  score                Int?
  fitScore             Int?
  intentScore          Int?
  engagementScore      Int?
  priority             LeadPriority              @default(MEDIUM)
  ownerId              String?
  owner                User?                     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  candidateConversions LeadCandidateConversion[]
  source               String?
  sourceCandidateId    String?
  sourceCandidate      LeadCandidate?  @relation("CandidateConversionLead", fields: [sourceCandidateId], references: [id], onDelete: SetNull)
  lists                LeadListMembership[]
  activities           Activity[]
  deals                Deal[]
  scores               LeadScore[]
  classifications      LeadClassification[]
  enrichmentRequests   EnrichmentRequest[]        @relation("LeadEnrichmentRequests")
  enrichmentConflicts  EnrichmentConflict[]       @relation("LeadEnrichmentConflicts")
  emailAddresses       EmailAddress[]
  emailDiscoveryJobs   EmailDiscoveryJob[]        @relation("LeadEmailDiscoveryJobs")
  leadReadinesses      LeadReadiness[]
  contactReadiness     Int?
  emailStatus          EmailStatus?
  doNotContact         Boolean                   @default(false)
  outreachStatus       OutreachStatus            @default(NOT_CONTACTED)
  nextAction           String?
  nextActionAt         DateTime?
  communications       Communication[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  lastActivityAt       DateTime?

  @@index([organizationId, status])
  @@index([organizationId, score])
  @@index([organizationId, priority])
  @@index([organizationId, ownerId])
  @@index([organizationId, companyId])
  @@index([organizationId, contactId])
  @@index([organizationId, createdAt])
  @@index([organizationId, updatedAt])
  @@index([organizationId, source])
  @@index([organizationId, sourceCandidateId])
}

model LeadList {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdById    String?
  createdBy      User?                @relation("LeadListCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships    LeadListMembership[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LeadListMembership {
  id        String   @id @default(cuid())
  listId    String
  list      LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([listId, leadId])
  @@index([leadId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type           ActivityType
  title          String
  description    String?
  createdById    String?
  createdBy      User?        @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, leadId])
  @@index([organizationId, companyId])
  @@index([organizationId, contactId])
  @@index([organizationId, createdAt])
}

model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  position       Int
  color          String?
  isClosed       Boolean      @default(false)
  isWon          Boolean      @default(false)
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, position])
}

model ICPProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  criteria       Json
  isActive       Boolean      @default(false)
  createdById    String?
  createdBy      User?        @relation("ICPCreator", fields: [createdById], references: [id], onDelete: SetNull)
  scraperRuns    ScraperRun[]
  scores         LeadScore[]
  scoreJobs      LeadScoreJob[]
  classifications LeadClassification[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
}

model Deal {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name              String
  value             Decimal       @default(0)
  currency          String        @default("USD")
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  expectedCloseDate DateTime?
  description       String?
  ownerId           String?
  owner             User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, stageId])
  @@index([organizationId, leadId])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt])
}

model LeadSource {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  type           LeadSourceType
  description    String?
  isActive       Boolean            @default(false)
  config         Json
  capabilities   SourceCapability[]
  createdById    String?
  createdBy      User?              @relation("LeadSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  runs           ScraperRun[]
  rawLeads       RawLead[]
  rawPages       RawPage[]
  leadCandidates LeadCandidate[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, type])
  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
}

model RawLead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceId       String
  source         LeadSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  runId          String
  run            ScraperRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalId     String?
  rawData        Json
  sourceUrl      String?
  discoveredAt   DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([organizationId, sourceId, externalId])
  @@index([organizationId, sourceId])
  @@index([organizationId, runId])
  @@index([organizationId, externalId])
  @@index([organizationId, createdAt])
}

model RawPage {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId          String
  run            ScraperRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId       String
  source         LeadSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  url            String
  statusCode     Int?
  errorCategory  String?
  title          String?
  contentType    String?
  html           String?        @db.Text
  textContent    String?        @db.Text
  metadata       Json?
  fetchedAt      DateTime       @default(now())
  createdAt      DateTime       @default(now())
  leadCandidate  LeadCandidate?

  @@index([organizationId, runId])
  @@index([organizationId, sourceId])
  @@index([organizationId, url])
  @@index([organizationId, statusCode])
  @@index([organizationId, createdAt])
}

model ScraperRun {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceId         String
  source           LeadSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  icpId            String?
  icp              ICPProfile?       @relation(fields: [icpId], references: [id], onDelete: SetNull)
  status           ScraperRunStatus  @default(QUEUED)
  startedAt        DateTime?
  finishedAt       DateTime?
  heartbeatAt      DateTime?
  recordsFound     Int               @default(0)
  recordsProcessed Int               @default(0)
  recordsCreated   Int               @default(0)
  recordsUpdated   Int               @default(0)
  recordsDuplicate Int               @default(0)
  recordsFailed    Int               @default(0)
  pagesDiscovered  Int               @default(0)
  pagesQueued      Int               @default(0)
  pagesProcessed   Int               @default(0)
  pagesSucceeded   Int               @default(0)
  pagesFailed      Int               @default(0)
  pagesSkipped     Int               @default(0)
  errorMessage     String?
  metadata         Json?
  events           ScraperRunEvent[]
  rawLeads         RawLead[]
  rawPages         RawPage[]
  extractionRun    ExtractionRun?
  leadCandidates   LeadCandidate[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, sourceId])
  @@index([organizationId, icpId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, startedAt])
  @@index([organizationId, status, heartbeatAt])
}

model ScraperRunEvent {
  id        String               @id @default(cuid())
  runId     String
  run       ScraperRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     ScraperRunEventLevel @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime             @default(now())

  @@index([runId, createdAt])
  @@index([runId, level])
}

// One extraction run per scraper run: observable progress + AI usage stats.
model ExtractionRun {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scraperRunId      String          @unique
  scraperRun        ScraperRun      @relation(fields: [scraperRunId], references: [id], onDelete: Cascade)
  status            CandidateStatus @default(PENDING)
  pagesProcessed    Int             @default(0)
  pagesSkipped      Int             @default(0)
  pagesFailed       Int             @default(0)
  candidatesCreated Int             @default(0)
  aiCalls           Int             @default(0)
  aiFailures        Int             @default(0)
  aiInputChars      Int             @default(0)
  aiOutputChars     Int             @default(0)
  startedAt         DateTime?
  finishedAt        DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, scraperRunId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// One candidate per crawled page; multiple people on a page become child
// CandidateContact rows, not separate candidates (spec §41).
model LeadCandidate {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId                String
  run                  ScraperRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId             String
  source               LeadSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  rawPageId            String            @unique
  rawPage              RawPage           @relation(fields: [rawPageId], references: [id], onDelete: Cascade)
  pageClassification   String?
  status               CandidateStatus   @default(PENDING)
  extractionMethod     ExtractionMethod?
  extractionConfidence Float?
  extractionVersion    String            @default("1")
  contentHash          String?
  aiUsed               Boolean           @default(false)

  companyName           String?
  normalizedCompanyName String?
  companyDomain         String?
  websiteUrl            String?
  description           String?
  industry              String?
  country               String?
  region                String?
  city                  String?
  logoUrl               String?

  contactFullName  String?
  contactFirstName String?
  contactLastName  String?
  contactJobTitle  String?
  email            String?
  phoneRaw         String?
  phone            String?
  normalizedPhone  String?
  linkedinUrl      String?

  socialLinks     Json?
  jobs            Json?
  fieldProvenance Json?
  fieldConfidence Json?
  rawData         Json?
  normalizedData  Json?

  dataQualityScore   Int?
  qualityFlags       Json?
  qualityExplanation Json?

  contacts             CandidateContact[]
  entityMatchesA       EntityMatch[]             @relation("matchA")
  entityMatchesB       EntityMatch[]             @relation("matchB")
  duplicateMemberships DuplicateGroupMember[]
  canonicalOfGroups    DuplicateGroup[]          @relation("canonicalOf")
  conversions          LeadCandidateConversion[]
  convertedLeads        Lead[]              @relation("CandidateConversionLead")
  scores               LeadScore[]
  enrichmentRequests   EnrichmentRequest[]  @relation("CandidateEnrichmentRequests")
  enrichmentConflicts  EnrichmentConflict[] @relation("CandidateEnrichmentConflicts")
  emailAddresses       EmailAddress[]
  emailDiscoveryJobs   EmailDiscoveryJob[]  @relation("CandidateEmailDiscoveryJobs")
  leadReadinesses      LeadReadiness[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([organizationId, rawPageId])
  @@index([organizationId, status])
  @@index([organizationId, runId])
  @@index([organizationId, sourceId])
  @@index([organizationId, companyDomain])
  @@index([organizationId, normalizedCompanyName])
  @@index([organizationId, email])
  @@index([organizationId, normalizedPhone])
  @@index([organizationId, linkedinUrl])
  @@index([organizationId, extractionMethod])
  @@index([organizationId, contentHash])
  @@index([organizationId, dataQualityScore])
  @@index([organizationId, createdAt])
}

model CandidateContact {
  id             String        @id @default(cuid())
  candidateId    String
  candidate      LeadCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName       String
  firstName      String?
  lastName       String?
  jobTitle       String?
  email          String?
  phone          String?
  linkedinUrl    String?
  confidence     Float?
  provenance     Json?
  createdAt      DateTime      @default(now())

  @@index([candidateId])
  @@index([organizationId, email])
  @@index([organizationId, fullName])
}

// ── TASK 009: duplicate resolution ───────────────────────────────────────

enum EntityType {
  COMPANY
  CONTACT
}

enum MatchConfidence {
  HIGH
  MEDIUM
  LOW
}

enum MatchStatus {
  AUTO_MATCH
  REVIEW
  NOT_MATCH
}

enum DuplicateGroupStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
  AUTO_MERGED
}

// Pairwise match between two candidates. candidateAId < candidateBId always
// (sorted at write time) so the pair identity is deterministic and unique.
model EntityMatch {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     EntityType
  candidateAId   String
  candidateA     LeadCandidate   @relation("matchA", fields: [candidateAId], references: [id], onDelete: Cascade)
  candidateBId   String
  candidateB     LeadCandidate   @relation("matchB", fields: [candidateBId], references: [id], onDelete: Cascade)
  score          Int
  confidence     MatchConfidence
  reasons        Json
  status         MatchStatus
  createdAt      DateTime        @default(now())

  @@unique([organizationId, candidateAId, candidateBId])
  @@index([organizationId, status])
  @@index([organizationId, entityType, status])
  @@index([organizationId, candidateAId])
  @@index([organizationId, candidateBId])
}

// A confirmed/reviewable duplicate group; members reference the original
// candidates (never deleted, provenance preserved).
model DuplicateGroup {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType           EntityType
  status               DuplicateGroupStatus   @default(PENDING_REVIEW)
  confidence           Int?
  canonicalCandidateId String?
  canonicalCandidate   LeadCandidate?         @relation("canonicalOf", fields: [canonicalCandidateId], references: [id], onDelete: SetNull)
  mergedData           Json?
  conflicts            Json?
  members              DuplicateGroupMember[]
  auditEvents          DuplicateAuditEvent[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, entityType, status])
  @@index([organizationId, canonicalCandidateId])
}

model DuplicateGroupMember {
  id               String         @id @default(cuid())
  duplicateGroupId String
  duplicateGroup   DuplicateGroup @relation(fields: [duplicateGroupId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        LeadCandidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  matchScore       Int?
  matchReasons     Json?
  addedAt          DateTime       @default(now())

  @@unique([duplicateGroupId, candidateId])
  @@index([candidateId])
  @@index([organizationId])
}

enum DuplicateAuditAction {
  USER_CONFIRMED_DUPLICATE
  USER_REJECTED_DUPLICATE
  CANONICAL_SELECTED
  AUTO_MERGED
}

model DuplicateAuditEvent {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupId        String
  group          DuplicateGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  action         DuplicateAuditAction
  actorUserId    String?
  actorName      String?
  details        Json?
  createdAt      DateTime             @default(now())

  @@index([organizationId, groupId, createdAt])
}

// TASK 010: persistent conversion record — explicit audit trail from
// LeadCandidate to CRM Company/Contact/Lead (§10, §26-§27, §87).
model LeadCandidateConversion {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId    String           @unique
  candidate      LeadCandidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status         ConversionStatus @default(NOT_CONVERTED)
  convertedById  String?
  convertedBy    User?            @relation("CandidateConverter", fields: [convertedById], references: [id], onDelete: SetNull)
  convertedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, companyId])
  @@index([organizationId, contactId])
  @@index([organizationId, leadId])
  @@index([organizationId, convertedAt])
}

// ── TASK 012: lead scoring + ICP qualification ────────────────────────────

enum ClassificationLabel {
  HIGH_FIT
  MEDIUM_FIT
  LOW_FIT
  INSUFFICIENT_DATA
}

enum Qualification {
  HOT
  GOOD
  MAYBE
  LOW
  UNQUALIFIED
}

enum ScoreSource {
  CANDIDATE
  CRM
}

enum ScoreStatus {
  CURRENT
  STALE
}

enum LeadScoreJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ScoringAuditAction {
  ICP_CREATED
  ICP_UPDATED
  ICP_ACTIVATED
  ICP_DEACTIVATED
  LEAD_SCORED
  LEAD_RESCORED
  BULK_SCORING_STARTED
  BULK_SCORING_COMPLETED
}

// Append-only scoring history. One row per scoring event; the newest row
// with scoreStatus CURRENT is the authoritative score (§16-§19, §61-§65).
model LeadScore {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  candidateId    String?
  candidate      LeadCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  icpProfileId   String?
  icpProfile     ICPProfile?   @relation(fields: [icpProfileId], references: [id], onDelete: SetNull)
  source         ScoreSource
  modelVersion   String
  icpScore       Int
  overallScore   Int
  qualification  Qualification
  scoreStatus    ScoreStatus   @default(CURRENT)
  scoreBreakdown Json
  reasons        Json
  scoredAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, leadId, scoreStatus])
  @@index([organizationId, leadId, scoredAt])
  @@index([organizationId, candidateId, scoreStatus])
  @@index([organizationId, candidateId, scoredAt])
  @@index([organizationId, icpProfileId])
  @@index([organizationId, qualification, scoreStatus])
  @@index([organizationId, overallScore, scoreStatus])
  @@index([organizationId, scoreStatus])
  @@index([organizationId, scoredAt])
}

// Bulk scoring job with observable progress (§59-§60).
model LeadScoreJob {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  icpProfileId   String?
  icpProfile     ICPProfile?        @relation(fields: [icpProfileId], references: [id], onDelete: SetNull)
  candidateIds   Json?
  status         LeadScoreJobStatus @default(PENDING)
  total          Int                @default(0)
  processed      Int                @default(0)
  scored         Int                @default(0)
  failed         Int                @default(0)
  hot            Int                @default(0)
  good           Int                @default(0)
  maybe          Int                @default(0)
  low            Int                @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// TASK 012 audit trail (§58): ICP lifecycle + scoring events.
// TASK 018: latest AI classification of a lead against an ICP (spec §19-§20).
// One row per (lead, ICP); re-classification replaces it in place. Purely
// interpretive — classification output is never written into factual CRM
// fields or deterministic scoring (spec §11, §32).
model LeadClassification {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId             String
  lead               Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  icpId              String
  icpProfile         ICPProfile          @relation(fields: [icpId], references: [id], onDelete: Cascade)
  classification     ClassificationLabel
  fitScore           Int
  reasons            Json
  concerns           Json
  matchedCriteria    Json
  unmatchedCriteria  Json
  evidenceReferences Json
  model              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, leadId, icpId])
  @@index([organizationId, leadId])
}

model ScoringAuditEvent {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action         ScoringAuditAction
  actorUserId    String?
  actorName      String?
  details        Json?
  createdAt      DateTime          @default(now())

  @@index([organizationId, action, createdAt])
  @@index([organizationId, createdAt])
}

// ── TASK 013: lead enrichment ─────────────────────────────────────────────

enum EnrichmentRequestStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum EnrichmentResultStatus {
  NEW
  CONFIRMED
  CONFLICT
  REJECTED
  STALE
}

enum EnrichmentConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ConflictResolution {
  KEEP_EXISTING
  ACCEPT_NEW
  KEEP_BOTH
  DISMISSED
}

enum EnrichmentErrorCode {
  TIMEOUT
  DNS_ERROR
  ROBOTS_BLOCKED
  RATE_LIMITED
  INVALID_URL
  PARSER_ERROR
  PROVIDER_ERROR
  INSUFFICIENT_DATA
  CANCELLED
}

enum EnrichmentAuditAction {
  ENRICHMENT_REQUESTED
  ENRICHMENT_STARTED
  ENRICHMENT_COMPLETED
  ENRICHMENT_FAILED
  FIELD_ENRICHED
  FIELD_CONFLICT_CREATED
  FIELD_CONFLICT_RESOLVED
  ENRICHMENT_FORCE_REFRESHED
  ENRICHMENT_CANCELLED
  ENRICHMENT_RETRIED
}

// Organization-level enrichment policy. Sensible safe defaults; crawler
// limits deliberately conservative — normal users cannot raise them.
model EnrichmentSettings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled            Boolean      @default(true)
  maxPagesPerCompany Int          @default(5)
  maxDepth           Int          @default(1)
  requestDelayMs     Int          @default(1000)
  requestTimeoutMs   Int          @default(15000)
  allowedDomains     Json?
  enabledProviders   Json?
  freshnessDays      Int          @default(7)
  batchMaxLeads      Int          @default(100)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// One enrichment job per (lead|candidate, provider) request.
model EnrichmentRequest {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?                    @relation("LeadEnrichmentRequests", fields: [leadId], references: [id], onDelete: Cascade)
  candidateId    String?
  candidate      LeadCandidate?           @relation("CandidateEnrichmentRequests", fields: [candidateId], references: [id], onDelete: Cascade)
  providerId     String
  status         EnrichmentRequestStatus  @default(QUEUED)
  forceRefresh   Boolean                  @default(false)
  retries        Int                      @default(0)
  requestedById  String?
  requestedBy    User?                    @relation("EnrichmentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt    DateTime                 @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorCode      EnrichmentErrorCode?
  errorMessage   String?
  pagesVisited   Int                      @default(0)
  fieldsFound    Int                      @default(0)
  fieldsUpdated  Int                      @default(0)
  conflictsCount Int                      @default(0)
  results        EnrichmentResult[]
  conflicts      EnrichmentConflict[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, candidateId, createdAt])
  @@index([organizationId, providerId, createdAt])
  @@index([organizationId, createdAt])
}

// One row per enriched field — independently traceable (§10-§11).
model EnrichmentResult {
  id              String                 @id @default(cuid())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestId       String
  request         EnrichmentRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  leadId          String?
  candidateId     String?
  field           String
  value           String
  normalizedValue String?
  source          String
  sourceUrl       String?
  evidence        String?
  method          String
  confidence      Float
  status          EnrichmentResultStatus @default(NEW)
  observedAt      DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([organizationId, requestId])
  @@index([organizationId, leadId, field])
  @@index([organizationId, candidateId, field])
  @@index([organizationId, field])
}

// A conflicting pair: existing vs enriched. Resolved by a user; the
// canonical entity value is only ever changed via resolution.
model EnrichmentConflict {
  id              String                  @id @default(cuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestId       String
  request         EnrichmentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?                   @relation("LeadEnrichmentConflicts", fields: [leadId], references: [id], onDelete: Cascade)
  candidateId     String?
  candidate       LeadCandidate?          @relation("CandidateEnrichmentConflicts", fields: [candidateId], references: [id], onDelete: Cascade)
  field           String
  existingValue   String
  enrichedValue   String
  existingSource  String
  enrichedSource  String
  confidence      Float
  status          EnrichmentConflictStatus @default(OPEN)
  resolution      ConflictResolution?
  resolvedById    String?
  resolvedBy      User?                   @relation("ConflictResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, leadId, status])
  @@index([organizationId, candidateId, status])
}

// TASK 013 audit trail: request lifecycle + field/conflict events.
model EnrichmentAuditEvent {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action         EnrichmentAuditAction
  actorUserId    String?
  actorName      String?
  details        Json?
  createdAt      DateTime              @default(now())

  @@index([organizationId, action, createdAt])
  @@index([organizationId, createdAt])
}

// ── TASK 014: email discovery & verification ──────────────────────────────

enum EmailType {
  PERSONAL_BUSINESS
  ROLE_BASED
  GENERIC
  UNKNOWN
}

// Lifecycle status of an email address. DISCOVERED ≠ VERIFIED (§2): an email
// is never claimed deliverable without verification evidence.
enum EmailStatus {
  UNKNOWN
  DISCOVERED
  VERIFIED
  LIKELY_VALID
  INVALID
  RISKY
  DISPOSABLE
  STALE
  CONFLICT
  REJECTED
  DO_NOT_CONTACT
  UNSUBSCRIBED
}

enum EmailSourceType {
  PUBLIC_WEBSITE
  ENRICHMENT
  USER_IMPORT
  MANUAL
  CRM
  OTHER_PROVIDER
}

enum EmailDomainMatch {
  DOMAIN_MATCH
  GENERIC_DOMAIN
  DOMAIN_MISMATCH
  NOT_APPLICABLE
}

enum EmailDiscoveryJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum EmailVerificationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum EmailVerificationBatchStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum EmailConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum EmailConflictResolution {
  KEEP_BOTH
  ACCEPT_NEW
  DISMISSED
}

enum EmailAuditAction {
  EMAIL_DISCOVERY_REQUESTED
  EMAIL_DISCOVERY_COMPLETED
  EMAIL_DISCOVERY_FAILED
  EMAIL_DISCOVERED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFICATION_COMPLETED
  EMAIL_VERIFICATION_FAILED
  EMAIL_MARKED_PRIMARY
  EMAIL_CONFLICT_CREATED
  EMAIL_CONFLICT_RESOLVED
  EMAIL_MANUALLY_INVALIDATED
  EMAIL_REMOVED
  EMAIL_ACCEPTED
  EMAIL_SETTINGS_UPDATED
  EMAIL_DRAFT_SAVED
  EMAIL_SENT
  EMAIL_SEND_FAILED
  EMAIL_DELIVERED
  EMAIL_BOUNCED
  EMAIL_UNSUBSCRIBED
  EMAIL_TEMPLATE_USED
  EMAIL_ACCOUNT_CHANGED
  EMAIL_REPLY_RECEIVED
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_WEBHOOK_RECEIVED
}

// Organization-level email policy. Defaults read from env; admins may tune.
model EmailSettings {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  discoveryEnabled       Boolean      @default(true)
  verificationEnabled    Boolean      @default(true)
  enrichmentFallback     Boolean      @default(true)
  verificationCacheDays  Int          @default(14)
  discoveryFreshnessDays Int          @default(14)
  batchMaxEmails         Int          @default(100)
  discoveryRateLimit     Int          @default(60)
  verificationRateLimit  Int          @default(120)
  genericDomains         Json?
  rolePrefixes           Json?
  disposableDomains      Json?
  enabledProviders       Json?
  sendingEnabled         Boolean      @default(false)
  dailySendLimit         Int          @default(100)
  hourlySendLimit        Int          @default(30)
  minDaysBetweenOutreach Int          @default(3)
  allowSendToUnverified  Boolean      @default(false)
  senderName             String?
  senderEmail            String?
  replyTo                String?
  signature              String?
  defaultAccountId       String?
  // TASK 016: business-hour scheduling (§40-§43). Timestamps stay UTC in the
  // DB; windows/weekends/blackouts are evaluated in the org timezone.
  timezone               String       @default("UTC")
  sendStartHour          Int          @default(9)
  sendEndHour            Int          @default(17)
  skipWeekends           Boolean      @default(true)
  blackoutDates          Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

// One row per discovered email address (company- or contact-level, §78).
// Unique identity per (organization, normalized email, owner) — dedupe and
// conflicts are resolved in the service layer.
model EmailAddress {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId             String?
  lead               Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  candidateId        String?
  candidate          LeadCandidate?     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            Contact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email              String
  normalizedEmail    String
  type               EmailType          @default(UNKNOWN)
  status             EmailStatus        @default(DISCOVERED)
  confidence         Float              @default(0.5)
  isPrimary          Boolean            @default(false)
  sourceType         EmailSourceType
  provider           String
  sourceUrl          String?
  evidence           String?
  observedAt         DateTime           @default(now())
  domainMatch        EmailDomainMatch   @default(NOT_APPLICABLE)
  verification       Json?
  verifiedAt         DateTime?
  expiresAt          DateTime?
  createdById        String?
events               EmailEvent[]
  conflicts            EmailConflict[]
  verificationJobs     EmailVerificationJob[]
  communications      Communication[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([organizationId, normalizedEmail, leadId, candidateId, companyId, contactId])
  @@index([organizationId, leadId])
  @@index([organizationId, candidateId])
  @@index([organizationId, companyId])
  @@index([organizationId, contactId])
  @@index([organizationId, normalizedEmail])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, isPrimary])
  @@index([organizationId, verifiedAt])
  @@index([organizationId, expiresAt])
  @@index([organizationId, createdAt])
}

// Append-only email history AND audit trail in one table: org-scoped events
// (emailId null) and per-email history (emailId set), §34 + §63.
model EmailEvent {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailId        String?
  email          EmailAddress? @relation(fields: [emailId], references: [id], onDelete: Cascade)
  action         EmailAuditAction
  actorUserId    String?
  actor          User?         @relation("EmailEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName      String?
  details        Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, emailId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, createdAt])
}

// A discovered address that differs from the current contact/lead primary —
// never auto-replaces; surfaced for human resolution (§32, §35).
model EmailConflict {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailId          String
  email            EmailAddress           @relation(fields: [emailId], references: [id], onDelete: Cascade)
  existingEmail    String
  discoveredEmail  String
  status           EmailConflictStatus    @default(OPEN)
  resolution       EmailConflictResolution?
  resolvedById     String?
  resolvedBy       User?                  @relation("EmailConflictResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, emailId])
}

// One discovery job per (entity, provider) request; idempotent (§82).
model EmailDiscoveryJob {
  id                    String                  @id @default(cuid())
  organizationId        String
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId                String?
  lead                  Lead?                   @relation("LeadEmailDiscoveryJobs", fields: [leadId], references: [id], onDelete: Cascade)
  candidateId           String?
  candidate             LeadCandidate?          @relation("CandidateEmailDiscoveryJobs", fields: [candidateId], references: [id], onDelete: Cascade)
  providerId            String
  status                EmailDiscoveryJobStatus @default(QUEUED)
  forceRefresh          Boolean                 @default(false)
  retries               Int                     @default(0)
  requestedById         String?
  requestedBy           User?                   @relation("EmailDiscoveryRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt           DateTime                @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  errorCode             String?
  errorMessage          String?
  emailsFound           Int                     @default(0)
  enrichmentRequestId   String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, candidateId, createdAt])
  @@index([organizationId, providerId, createdAt])
  @@index([organizationId, createdAt])
}

// One verification job per email; failures stay isolated (§83).
model EmailVerificationJob {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailId        String
  email          EmailAddress               @relation(fields: [emailId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          EmailVerificationBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  providerId     String
  status         EmailVerificationJobStatus @default(PENDING)
  errorCode      String?
  errorMessage   String?
  checkedAt      DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, emailId])
  @@index([organizationId, batchId])
}

// Bulk verification batch with observable progress (§84).
model EmailVerificationBatch {
  id             String                       @id @default(cuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String?
  requestedBy    User?                        @relation("EmailVerificationRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  status         EmailVerificationBatchStatus @default(PENDING)
  total          Int                          @default(0)
  processed      Int                          @default(0)
  verified       Int                          @default(0)
  invalid        Int                          @default(0)
  unknown        Int                          @default(0)
  failed         Int                          @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  jobs           EmailVerificationJob[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// Append-only contact readiness history (§71-§73). The newest row is the
// authoritative score; Lead.contactReadiness mirrors it for fast sort/filter.
model LeadReadiness {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  candidateId    String?
  candidate      LeadCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  score          Int
  modelVersion   String
  breakdown      Json
  reasons        Json
  calculatedAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([organizationId, leadId, calculatedAt])
  @@index([organizationId, candidateId, calculatedAt])
}

// ── TASK 015: sales outreach & communication ──────────────────────────────

enum OutreachStatus {
  NOT_CONTACTED
  CONTACTED
  REPLIED
  MEETING_BOOKED
  QUALIFIED
  DISQUALIFIED
  NURTURE
  DO_NOT_CONTACT
}

enum CommunicationChannel {
  EMAIL
  CALL
  NOTE
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
  INTERNAL
}

// DELIVERED is only claimed when the provider supplies delivery evidence.
enum CommunicationStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  TEMPORARY_FAILURE
  FAILED
  CANCELLED
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  VOICEMAIL
  WRONG_NUMBER
  FOLLOW_UP_REQUIRED
}

enum EmailTemplateCategory {
  INTRODUCTION
  FOLLOW_UP
  DEMO
  PARTNERSHIP
  GENERAL
}

enum EmailTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum EmailAccountStatus {
  ACTIVE
  DISABLED
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

// Normalized send errors (provider + pre-send safety). Never surface raw
// provider secrets/errors to users (§67).
enum EmailSendErrorCode {
  AUTH_FAILED
  RATE_LIMITED
  INVALID_RECIPIENT
  PROVIDER_UNAVAILABLE
  MESSAGE_REJECTED
  NOT_CONFIGURED
  DO_NOT_CONTACT
  UNSUBSCRIBED
  COOLDOWN
  LIMIT_REACHED
  UNKNOWN
}

// Sending identity. Provider secrets are never stored in the DB — they are
// resolved from environment configuration at send time (§18, §19).
model EmailAccount {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String            @default("smtp")
  name           String
  email          String
  status         EmailAccountStatus @default(ACTIVE)
  isDefault      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

// Reusable outreach templates (§31-§37). Archived, never hard-deleted.
model EmailTemplate {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  category       EmailTemplateCategory @default(GENERAL)
  subject        String
  body           String
  status         EmailTemplateStatus  @default(ACTIVE)
  createdById    String?
  createdBy      User?                @relation("EmailTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, status, category, updatedAt])
}

// One message/event in the lead's communication history. Threading-ready via
// threadId/inReplyToId; append-only records (drafts share the table via
// status = DRAFT). Communication row is the source of truth; an Activity row
// mirrors it for the generic timeline component.
model Communication {
  id                String                 @id @default(cuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  emailId           String?
  email             EmailAddress?          @relation(fields: [emailId], references: [id], onDelete: SetNull)
  threadId          String?
  inReplyToId       String?
  channel           CommunicationChannel   @default(EMAIL)
  direction         CommunicationDirection @default(OUTBOUND)
  status            CommunicationStatus    @default(DRAFT)
  subject           String?
  body              String?
  cc                String?
  bcc               String?
  provider          String?
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  idempotencyKey    String?
  metadata          Json?
  createdById       String?
  createdBy         User?                  @relation("CommunicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  outboxMessage     OutboxMessage?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, createdById, createdAt])
  @@index([organizationId, channel, createdAt])
  @@index([organizationId, status, createdAt])
}

// Queue-backed sending (§69). One row per send attempt of a Communication.
model OutboxMessage {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communicationId String       @unique
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  status          OutboxStatus @default(PENDING)
  attempts        Int          @default(0)
  errorCode       String?
  lastError       String?
  scheduledFor    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
}

// Idempotent inbound provider events (delivered/bounced/failed/opened/
// clicked/complaint/unsubscribe). providerEventId is unique per org so a
// duplicate webhook is never processed twice (§58).
model EmailWebhookEvent {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerEventId String
  provider        String
  eventType       String
  subjectId       String?
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([organizationId, providerEventId])
  @@index([organizationId, provider, createdAt])
}

// ═════════════════════════════════════════════════════════════════════════
// TASK 016: automated outreach sequences & follow-up engine.
// Deterministic, config-driven step engine. No code execution, no AI, no
// limit bypass: every automated send re-uses TASK 015 safety/limits.
// ═════════════════════════════════════════════════════════════════════════

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SequenceStepType {
  EMAIL
  WAIT
  TASK
  CONDITION
  END
}

enum WaitUnit {
  MINUTES
  HOURS
  DAYS
}

enum SequenceEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
  FAILED
  UNSUBSCRIBED
  BOUNCED
}

enum SequenceExitReason {
  COMPLETED
  REPLIED
  MEETING_BOOKED
  DISQUALIFIED
  UNSUBSCRIBED
  BOUNCED
  MANUAL_STOP
  SEQUENCE_ARCHIVED
  DO_NOT_CONTACT
  FAILED
}

enum SequenceStepExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  SKIPPED
  FAILED
  CANCELLED
}

enum SequencePauseReason {
  USER_PAUSED
  SEQUENCE_PAUSED
  SYSTEM_PAUSED
  PROVIDER_ISSUE
  MISSING_DATA
}

enum SequenceAuditAction {
  SEQUENCE_CREATED
  SEQUENCE_UPDATED
  SEQUENCE_ACTIVATED
  SEQUENCE_PAUSED
  SEQUENCE_ARCHIVED
  SEQUENCE_CLONED
  ENROLLMENT_CREATED
  ENROLLMENT_PAUSED
  ENROLLMENT_RESUMED
  ENROLLMENT_STOPPED
  SEQUENCE_STEP_EXECUTED
  SEQUENCE_STEP_FAILED
  SEQUENCE_COMPLETED
  SEQUENCE_STOPPED
}

model Sequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         SequenceStatus @default(DRAFT)
  version        Int          @default(1)
  // Optional per-sequence cap on automated emails per rolling day. Must be
  // <= organization policy (enforced in service, §45).
  maxDailyEmails Int?
  ownerId        String?
  createdById    String?
  steps          SequenceStep[]
  enrollments    SequenceEnrollment[]
  auditEvents    SequenceAuditEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, updatedAt])
}

// Live builder steps. Execution never reads these after enrollment: each
// enrollment carries an immutable snapshot (stepsJson) so edits do not
// rewrite history (§48-§49, §88-§89).
model SequenceStep {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  position   Int
  type       SequenceStepType
  name       String
  config     Json
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([sequenceId, position])
}

model SequenceEnrollment {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sequenceId      String
  sequence        Sequence                 @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  leadId          String
  contactId       String?
  emailId         String?
  status          SequenceEnrollmentStatus @default(ACTIVE)
  version         Int                      @default(1)
  // Immutable step snapshot captured at enrollment time (§48-§49).
  stepsJson       Json
  currentPosition Int?
  nextRunAt       DateTime?
  pauseReason     SequencePauseReason?
  startedAt       DateTime                 @default(now())
  completedAt     DateTime?
  exitReason      SequenceExitReason?
  enrolledById    String?
  // Partial-unique guard: "ACTIVE" when status = ACTIVE, null otherwise.
  // Enforces one active enrollment per (org, sequence, lead) (§12, §82).
  activeGuard     String?
  executions      SequenceStepExecution[]
  tasks           SequenceTask[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([organizationId, sequenceId, leadId, activeGuard])
  @@index([organizationId, sequenceId, status])
  @@index([organizationId, status, nextRunAt])
  @@index([organizationId, leadId, status])
}

// One row per (enrollment, position) — the claim/lock for step execution.
// Idempotency: an execution can only be claimed once; retries mutate the
// same row (attempts, backoff), never duplicate it (§36-§39, §84-§87).
model SequenceStepExecution {
  id              String                     @id @default(cuid())
  organizationId  String
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollmentId    String
  enrollment      SequenceEnrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId          String?
  position        Int
  status          SequenceStepExecutionStatus @default(PENDING)
  scheduledAt     DateTime                   @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  attempts        Int                        @default(0)
  errorCode       String?
  errorMessage    String?
  communicationId String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([enrollmentId, position])
  @@index([organizationId, status, scheduledAt])
}

// Manual CRM task created by a TASK step (§72-§74).
model SequenceTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollmentId   String?
  enrollment     SequenceEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sequenceId     String?
  leadId         String?
  contactId      String?
  title          String
  description    String?
  assignedToId   String?
  dueAt          DateTime?
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, assignedToId, dueAt])
  @@index([organizationId, leadId])
}

model SequenceAuditEvent {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action         SequenceAuditAction
  sequenceId     String?
  sequence       Sequence?           @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  enrollmentId   String?
  actorUserId    String?
  actorName      String?
  details        Json?
  createdAt      DateTime            @default(now())

  @@index([organizationId, sequenceId, createdAt])
  @@index([organizationId, createdAt])
}
