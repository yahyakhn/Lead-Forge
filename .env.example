# PostgreSQL (compose defaults: user/password/db all "leadforge")
DATABASE_URL=postgresql://leadforge:leadforge@localhost:5432/leadforge?schema=public

# Redis for background jobs (scraper queue, from TASK 007 onward)
REDIS_URL=redis://localhost:6379

# AI provider (from TASK 008 onward)
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_API_KEY=

# Application
APP_URL=http://localhost:3000

# Web crawler (TASK 007)
# NEVER set this to true in production: it disables SSRF protection so the
# crawler may fetch local/private-network URLs (used by automated tests
# against a local HTTP server).
ALLOW_PRIVATE_NETWORK_TARGETS=false
# User-Agent the crawler sends. Must identify the tool; do not impersonate
# search engines or browsers. Optional.
LEAD_ENGINE_USER_AGENT=StartupLeadEngineBot/1.0